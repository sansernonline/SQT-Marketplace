<!--
  FluentTokens.xaml — WinUI 3 / Windows App SDK
  โทเคนชุดเดียวกับ assets/fluent.css แปลงเป็น ThemeDictionaries

  วิธีใช้ใน App.xaml:
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
          <ResourceDictionary Source="ms-appx:///Assets/FluentTokens.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Application.Resources>

  ต้องเมิร์จ "หลัง" XamlControlsResources เสมอ ไม่งั้นค่าจะถูกทับกลับ

  หมายเหตุ: key ที่ชื่อตรงกับของ WinUI (AccentFillColorDefaultBrush,
  TextFillColorPrimaryBrush ฯลฯ) จะไป override คอนโทรลมาตรฐานทั้งแอปโดยอัตโนมัติ
  ส่วน key ที่ขึ้นต้นด้วย App* เป็นของเราเอง ใช้กับ layout ที่เขียนเอง
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <!-- ================= DARK (Default) ================= -->
    <ResourceDictionary x:Key="Default">
      <!-- แบรนด์ -->
      <Color x:Key="AppAccentColor">#4CC2FF</Color>
      <Color x:Key="AppAccentTextColor">#99EBFF</Color>

      <!-- พื้นผิว -->
      <SolidColorBrush x:Key="AppBackgroundBrush"      Color="#000000"/>
      <SolidColorBrush x:Key="AppLayerBrush"           Color="#000000"/>
      <SolidColorBrush x:Key="AppCardBrush"            Color="#0F0F0F"/>
      <SolidColorBrush x:Key="AppCardSecondaryBrush"   Color="#1C1C1C"/>
      <SolidColorBrush x:Key="AppDividerBrush"         Color="#2D2D2D"/>

      <!-- ตัวอักษร (ทับของ WinUI เพื่อให้ทั้งแอปเหมือนกัน) -->
      <SolidColorBrush x:Key="TextFillColorPrimaryBrush"   Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#CCCCCC"/>
      <SolidColorBrush x:Key="TextFillColorTertiaryBrush"  Color="#8B8B8B"/>
      <SolidColorBrush x:Key="TextFillColorDisabledBrush"  Color="#767676"/>

      <!-- accent ของคอนโทรลมาตรฐาน -->
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush"   Color="#4CC2FF"/>
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#47B1E8"/>
      <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#99EBFF"/>
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000"/>

      <!-- สถานะ (ค่าจริงของ WinUI dark) -->
      <SolidColorBrush x:Key="AppSuccessBrush"    Color="#6CCB5F"/>
      <SolidColorBrush x:Key="AppSuccessBgBrush"  Color="#393D1B"/>
      <SolidColorBrush x:Key="AppCautionBrush"    Color="#FCE100"/>
      <SolidColorBrush x:Key="AppCautionBgBrush"  Color="#433519"/>
      <SolidColorBrush x:Key="AppCriticalBrush"   Color="#FF99A4"/>
      <SolidColorBrush x:Key="AppCriticalBgBrush" Color="#442726"/>
      <SolidColorBrush x:Key="AppInfoBrush"       Color="#60CDFF"/>
      <SolidColorBrush x:Key="AppInfoBgBrush"     Color="#2E2E2E"/>
    </ResourceDictionary>

    <!-- ================= LIGHT ================= -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="AppAccentColor">#005FB8</Color>
      <Color x:Key="AppAccentTextColor">#003E92</Color>

      <SolidColorBrush x:Key="AppBackgroundBrush"    Color="#F3F3F3"/>
      <SolidColorBrush x:Key="AppLayerBrush"         Color="#F9F9F9"/>
      <SolidColorBrush x:Key="AppCardBrush"          Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AppCardSecondaryBrush" Color="#F6F6F6"/>
      <SolidColorBrush x:Key="AppDividerBrush"       Color="#E5E5E5"/>

      <SolidColorBrush x:Key="TextFillColorPrimaryBrush"   Color="#1A1A1A"/>
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5D5D5D"/>
      <SolidColorBrush x:Key="TextFillColorTertiaryBrush"  Color="#8B8B8B"/>
      <SolidColorBrush x:Key="TextFillColorDisabledBrush"  Color="#A5A5A5"/>

      <SolidColorBrush x:Key="AccentFillColorDefaultBrush"   Color="#005FB8"/>
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#1A6EC0"/>
      <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#003E92"/>
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>

      <SolidColorBrush x:Key="AppSuccessBrush"    Color="#0F7B0F"/>
      <SolidColorBrush x:Key="AppSuccessBgBrush"  Color="#DFF6DD"/>
      <SolidColorBrush x:Key="AppCautionBrush"    Color="#9D5D00"/>
      <SolidColorBrush x:Key="AppCautionBgBrush"  Color="#FFF4CE"/>
      <SolidColorBrush x:Key="AppCriticalBrush"   Color="#C42B1C"/>
      <SolidColorBrush x:Key="AppCriticalBgBrush" Color="#FDE7E9"/>
      <SolidColorBrush x:Key="AppInfoBrush"       Color="#005FB8"/>
      <SolidColorBrush x:Key="AppInfoBgBrush"     Color="#F4F9FF"/>
    </ResourceDictionary>

    <!-- ================= HIGH CONTRAST =================
         ห้ามใส่สีตายตัว — ต้องดึงจากสีระบบเท่านั้น ไม่งั้นแอปใช้ไม่ได้
         สำหรับผู้ใช้ที่เปิดโหมดคอนทราสต์สูง -->
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="AppLayerBrush"      Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="AppCardBrush"       Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="AppDividerBrush"    Color="{ThemeResource SystemColorWindowTextColor}"/>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ================= ค่าที่ไม่ขึ้นกับธีม ================= -->
  <x:Double x:Key="NavPaneOpenWidth">320</x:Double>
  <x:Double x:Key="ContentMaxWidth">1064</x:Double>
  <x:Double x:Key="TitleBarHeight">48</x:Double>

  <CornerRadius x:Key="ControlCornerRadiusApp">4</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <Thickness   x:Key="CardPadding">16</Thickness>
  <Thickness   x:Key="ContentGutter">36,8,36,48</Thickness>
  <Thickness   x:Key="SectionSpacing">0,0,0,40</Thickness>

  <!-- Type ramp — ใช้ชื่อของ WinUI ที่มีอยู่แล้วเป็นหลัก:
       CaptionTextBlockStyle · BodyTextBlockStyle · BodyStrongTextBlockStyle
       SubtitleTextBlockStyle · TitleTextBlockStyle · TitleLargeTextBlockStyle
       อย่าสร้าง style ขนาดใหม่เอง เว้นแต่ ramp มาตรฐานไม่มีจริง ๆ -->

  <!-- ฟอนต์: Segoe UI Variable ไม่มีอักษรไทย ระบบจะ fallback ไป Leelawadee UI ให้เอง
       ถ้าอยากคุมเอง ตั้ง FontFamily="Segoe UI Variable Text, Leelawadee UI" -->
  <x:String x:Key="AppFontFamily">Segoe UI Variable Text, Leelawadee UI</x:String>

</ResourceDictionary>
