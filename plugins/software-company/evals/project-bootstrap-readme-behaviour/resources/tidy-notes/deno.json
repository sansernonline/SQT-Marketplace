{
  "name": "@sqt/tidy-notes",
  "version": "0.3.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-read --allow-write --watch src/main.ts",
    "test": "deno test --allow-read",
    "check": "deno fmt --check && deno lint",
    "compile": "deno compile --allow-read --allow-write -o dist/tidy-notes src/main.ts"
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0"
  }
}
